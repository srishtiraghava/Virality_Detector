APP_NAME=ViralScope AI
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://<username>:<password>@127.0.0.1:5433/<database>
SECRET_KEY=replace_me
ACCESS_TOKEN_EXPIRE_MINUTES=30
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/1
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=500
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AUDIO_PROBE_TIMEOUT_SECONDS=20
AUDIO_EXTRACTION_TIMEOUT_SECONDS=120
AUDIO_MAX_DURATION_SECONDS=600
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_CPU_THREADS=4
WHISPER_DOWNLOAD_ROOT=

POSTGRES_USER=replace_with_a_local_username
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=viralscope
POSTGRES_PORT=5433
REDIS_PORT=6380
